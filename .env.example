# Local development placeholders only. Copy to .env and change the password.
POSTGRES_USER=rf_dataops
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=rf_dataops
POSTGRES_PORT=55432
API_PORT=8000
WEB_PORT=18080

# Application settings. Compose overrides the host and port inside containers.
RF_DATABASE_HOST=127.0.0.1
RF_DATABASE_PORT=55432
RF_DATABASE_USER=rf_dataops
RF_DATABASE_PASSWORD=local_dev_change_me
RF_DATABASE_NAME=rf_dataops
RF_DATA_ROOT=./data
RF_DATA_ROOT_KEY=default
RF_MAX_SCAN_FILES=1000
RF_MAX_SEGMENTS_PER_CALL=1000
RF_LOG_LEVEL=INFO
RF_SESSION_MINUTES=30
RF_MODEL_ROOT=./models
RF_WORKER_LEASE_SECONDS=30
RF_WORKER_HEARTBEAT_SECONDS=5
RF_WORKER_RECOVERY_SECONDS=5
RF_WORKER_POLL_SECONDS=1
RF_RETRY_BASE_SECONDS=2
